# This repository is a safe catalog, not a raw mirror of E:\aimodel.
# Ignore every top-level item unless it is explicitly allow-listed below.
/*

!/.gitignore
!/README.md
!/CHANGELOG.md

!/docs/
!/docs/**

!/scripts/
!/scripts/**

!/sklib/
!/sklib/**

!/multi-search-engine/
!/multi-search-engine/**

!/zhihu-cli-skill/
!/zhihu-cli-skill/**

# Exclude generated Python caches from the allow-listed source directories.
**/__pycache__/
*.pyc
*.pyo
